
{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Threat percentages across six Australian fauna groups.",

  "background": "white",

  "width": 660,
  "height": 340,

  "padding": {
    "left": 125,
    "right": 20,
    "top": 15,
    "bottom": 80
  },

  "data": {
    "url": "data/processed/chart08_threat_heatmap.csv",
    "format": {
      "type": "csv",
      "parse": {
        "percent": "number",
        "affected_taxa": "number",
        "assessed_taxa": "number"
      }
    }
  },

  "encoding": {
    "x": {
      "field": "threat",
      "type": "nominal",
      "sort": [
        "Habitat loss",
        "Invasives & disease",
        "Fire regimes",
        "Climate & weather",
        "Water changes",
        "Ecosystem disruption",
        "Direct human harm",
        "Pollution"
      ],

      "axis": {
        "title": null,
        "labelAngle": -36,
        "labelFont": "Source Sans 3",
        "labelFontSize": 12,
        "labelColor": "#354C42",
        "labelLimit": 180,
        "labelPadding": 10
      }
    },

    "y": {
      "field": "group",
      "type": "nominal",
      "sort": [
        "Birds",
        "Mammals",
        "Reptiles",
        "Frogs",
        "Fish",
        "Invertebrates"
      ],

      "axis": {
        "title": null,
        "labelFont": "Source Sans 3",
        "labelFontSize": 13,
        "labelColor": "#354C42",
        "labelPadding": 10,
        "labelLimit": 180,
        "ticks": false,
        "domain": false
      }
    },

    "tooltip": [
      {
        "field": "group",
        "type": "nominal",
        "title": "Animal group"
      },
      {
        "field": "original_threat",
        "type": "nominal",
        "title": "Threat category"
      },
      {
        "field": "affected_taxa",
        "type": "quantitative",
        "title": "Taxa affected",
        "format": ",d"
      },
      {
        "field": "assessed_taxa",
        "type": "quantitative",
        "title": "Taxa assessed",
        "format": ",d"
      },
      {
        "field": "percent",
        "type": "quantitative",
        "title": "Share affected (%)",
        "format": ".1f"
      }
    ]
  },

  "layer": [
    {
      "mark": {
        "type": "rect",
        "stroke": "#FFFFFF",
        "strokeWidth": 3,
        "cornerRadius": 3
      },

      "encoding": {
        "color": {
          "field": "percent",
          "type": "quantitative",

          "scale": {
            "domain": [0, 100],
            "range": [
              "#ECF1E8",
              "#215A45"
            ]
          },

          "legend": {
            "title": "Taxa affected (%)",
            "orient": "bottom",
            "gradientLength": 230,
            "labelFontSize": 11
          }
        }
      }
    },

    {
      "mark": {
        "type": "text",
        "font": "Source Sans 3",
        "fontSize": 12,
        "fontWeight": "bold"
      },

      "encoding": {
        "text": {
          "field": "label",
          "type": "nominal"
        },

        "color": {
          "condition": {
            "test": "datum.percent >= 50",
            "value": "#FFFFFF"
          },
          "value": "#274036"
        }
      }
    }
  ],

  "config": {
    "font": "Source Sans 3",
    "view": {
      "stroke": null
    }
  }
}
