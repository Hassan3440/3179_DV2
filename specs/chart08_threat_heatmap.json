
{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "description": "Eucalyptus-green heatmap of recorded threats on assessed Australian fauna.",

  "background": "#FFFFFF",

  "width": 820,
  "height": 355,

  "padding": {
    "left": 15,
    "right": 20,
    "top": 12,
    "bottom": 18
  },

  "title": {
    "text": "The wildlife threat fingerprint",
    "subtitle": [
      "Each cell shows the share of assessed taxa affected by a threat.",
      "Darker eucalyptus-green tiles indicate higher percentages."
    ],
    "anchor": "start",
    "font": "Fraunces",
    "fontSize": 22,
    "fontWeight": 600,
    "color": "#234B3E",
    "subtitleFont": "Source Sans 3",
    "subtitleFontSize": 13,
    "subtitleColor": "#667E70",
    "offset": 22
  },

  "data": {
    "url": "data/processed/chart08_threat_heatmap.csv",
    "format": {
      "type": "csv",
      "parse": {
        "percent": "number",
        "affected_taxa": "number",
        "assessed_taxa": "number"
      }
    }
  },

  "encoding": {
"x": {
  "field": "threat",
  "type": "nominal",
  "sort": [
    "Habitat loss",
    "Invasives & disease",
    "Fire regimes",
    "Climate & weather",
    "Water changes",
    "Ecosystem disruption",
    "Direct human harm",
    "Pollution"
  ],
  "scale": {
    "paddingInner": 0.035,
    "paddingOuter": 0.015
  },
  "axis": {
    "title": null,
    "labelAngle": -32,
    "labelFontSize": 13,
    "labelColor": "#365B4C",
    "labelFontWeight": 600,
    "labelLimit": 1000,
    "labelPadding": 14,
    "labelOverlap": false,
    "ticks": false,
    "domain": false
  }
},

    "y": {
      "field": "group",
      "type": "nominal",
      "sort": [
        "Birds",
        "Mammals",
        "Reptiles",
        "Frogs",
        "Fish",
        "Invertebrates"
      ],
      "scale": {
        "paddingInner": 0.035,
        "paddingOuter": 0.015
      },
      "axis": {
        "title": null,
        "labelFontSize": 14,
        "labelColor": "#284F3D",
        "labelFontWeight": 600,
        "labelPadding": 14,
        "ticks": false,
        "domain": false
      }
    },

    "tooltip": [
      {
        "field": "group",
        "type": "nominal",
        "title": "Animal group"
      },
      {
        "field": "original_threat",
        "type": "nominal",
        "title": "Threat category"
      },
      {
        "field": "affected_taxa",
        "type": "quantitative",
        "title": "Taxa affected",
        "format": ",d"
      },
      {
        "field": "assessed_taxa",
        "type": "quantitative",
        "title": "Taxa assessed",
        "format": ",d"
      },
      {
        "field": "percent",
        "type": "quantitative",
        "title": "Affected (%)",
        "format": ".1f"
      }
    ]
  },

  "layer": [
    {
      "mark": {
        "type": "rect",
        "cornerRadius": 6,
        "stroke": "#FFFFFF",
        "strokeWidth": 3
      },

      "encoding": {
        "color": {
          "field": "percent",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              25,
              50,
              75,
              100
            ],
            "range": [
              "#EDF2EA",
              "#C5D7C8",
              "#91AF99",
              "#56836B",
              "#285540"
            ]
          },
          "legend": {
            "title": "Taxa affected (%)",
            "orient": "bottom",
            "direction": "horizontal",
            "gradientLength": 360,
            "gradientThickness": 16,
            "labelFontSize": 12,
            "titleFontSize": 13,
            "titlePadding": 12
          }
        }
      }
    },

    {
      "mark": {
        "type": "text",
        "font": "Source Sans 3",
        "fontSize": 15,
        "fontWeight": "bold"
      },

      "encoding": {
        "text": {
          "field": "label",
          "type": "nominal"
        },
        "color": {
          "condition": {
            "test": "datum.percent >= 60",
            "value": "#FFFFFF"
          },
          "value": "#254538"
        }
      }
    }
  ],

  "config": {
    "font": "Source Sans 3",

    "view": {
      "stroke": null
    },

    "axis": {
      "labelFont": "Source Sans 3",
      "titleFont": "Source Sans 3"
    },

    "legend": {
      "labelFont": "Source Sans 3",
      "titleFont": "Source Sans 3",
      "labelColor": "#5A7765",
      "titleColor": "#234B3E"
    }
  }
}
